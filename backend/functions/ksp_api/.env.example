# Port the Express API listens on. The frontend dev proxy expects 3000.
PORT=3000

# Path to the SQLite DB, relative to this package's root (backend/functions/ksp_api).
# Defaults to ../../../frontend/data/fir_system.sqlite if left unset.
DB_PATH=../../../frontend/data/fir_system.sqlite

# Secret used to sign JWTs. MUST be a long random string in any shared/deployed
# environment — generate one with: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
# If unset, a hardcoded insecure dev value is used and a warning is printed (NODE_ENV=production refuses to start without it).
JWT_SECRET=replace-with-a-long-random-local-only-secret

# How long an issued login token stays valid before re-login is required.
JWT_EXPIRES_IN=12h

# Origin allowed to call this API with credentials — must match where the frontend is served from.
CORS_ORIGIN=http://localhost:5173

# info | debug | warn | error — currently only affects console verbosity, no log file is written.
LOG_LEVEL=info

# development | production. production enforces JWT_SECRET being set (see above).
NODE_ENV=development
