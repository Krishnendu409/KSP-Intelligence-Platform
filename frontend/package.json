    "express": "^5.2.1",
    "leaflet": "^1.9.4",
    "leaflet-geosearch": "^4.4.0",
    "lucide-react": "^1.24.0",
    "maplibre-gl": "^4.7.1",
    "maplibre-gl-js-amplify": "^4.0.3",
    "pino": "^10.3.1",
