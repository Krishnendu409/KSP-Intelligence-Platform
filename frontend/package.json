    "react-force-graph-2d": "^1.29.1",
    "react-leaflet": "^5.0.0",
    "react-map-gl": "^8.1.1",
    "react-router-dom": "^7.18.1",
    "recharts": "^3.9.2",
    "swagger-ui-express": "^5.0.1",
    "tailwind-merge": "^3.6.0",
    "yaml": "^2.9.0",
    "zod": "^4.4.3",
    "zustand": "^5.0.14"
