{
  "name": "frontend",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "test": "vitest run",
    "server": "tsx --tsconfig tsconfig.node.json scripts/start-server.ts",
