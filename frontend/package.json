    "seed": "tsx --tsconfig tsconfig.node.json scripts/seed.ts",
    "reset-db": "tsx --tsconfig tsconfig.node.json scripts/reset-db.ts",
    "generate-client": "openapi --input apps/intelligence-os/server/api/openapi.yaml --output packages/shared/client --client axios",
    "validate-contract": "tsx --tsconfig tsconfig.node.json scripts/validate-api-contract.ts"
  },
  "dependencies": {
    "@types/cytoscape": "^3.21.9",
    "axios": "^1.18.1",
